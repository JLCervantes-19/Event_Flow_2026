# ============================================================
#  EventFlow — Variables de Entorno
#  Renombra este archivo a .env y completa tus valores
# ============================================================

# Puerto del servidor (default: 3000)
# El servidor Express escuchará en este puerto en desarrollo local
PORT=3000

# Cadena de conexión a MongoDB
# Para MongoDB Atlas (recomendado para producción):
# MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/eventflow?retryWrites=true&w=majority
# Para MongoDB local (desarrollo):
# MONGO_URI=mongodb://localhost:27017/eventflow
# Nota: Asegúrate de incluir los parámetros retryWrites=true&w=majority para MongoDB Atlas
MONGO_URI=mongodb+srv://jhanleiderc_db_user:TnN2XHYiSG3tVvLR@eventflow.8pghzho.mongodb.net/?appName=EventFlow

# Entorno de ejecución
# Valores válidos: development, production
# En desarrollo local usa 'development', en Vercel usa 'production'
NODE_ENV=development

# Origen CORS personalizado (opcional)
# Usa esta variable para permitir solicitudes desde un dominio personalizado en producción
# Ejemplo: CORS_ORIGIN=https://eventflow.com
# En desarrollo, se permiten automáticamente localhost:3000 y 127.0.0.1:5500
# En producción, se permite automáticamente VERCEL_URL si está disponible
CORS_ORIGIN=
